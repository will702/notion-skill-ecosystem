  "formulas": [
    {
      "database": "Projects",
      "property": "Progress",
      "expression": "if(prop(\"Total\") == 0, \"No items\", let(pct, prop(\"Completed\") / prop(\"Total\"),\n  repeat(\"█\", round(pct * 10)) + repeat(\"░\", 10 - round(pct * 10)) + \" \" + format(round(pct * 100)) + \"%\"))"
    },
    {
      "database": "Projects",
      "property": "Urgency",
      "expression": "ifs(\n  empty(prop(\"Due Date\")), \"No date\",\n  dateBetween(prop(\"Due Date\"), now(), \"days\") < 0 and prop(\"Status\") != \"Done\", \"Overdue\",\n  dateBetween(prop(\"Due Date\"), now(), \"days\") == 0 and prop(\"Status\") != \"Done\", \"Due today\",\n  \"On track\")"
    }
  ],
