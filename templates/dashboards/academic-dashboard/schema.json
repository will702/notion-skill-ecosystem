  "formulas": {
    "Progress": "if(prop(\"Total\") == 0, \"No items\", let(pct, prop(\"Completed\") / prop(\"Total\"), repeat(\"█\", round(pct * 10)) + repeat(\"░\", 10 - round(pct * 10)) + \" \" + format(round(pct * 100)) + \"%\"))",
    "Urgency": "ifs(empty(prop(\"Due Date\")), \"No date\", dateBetween(prop(\"Due Date\"), now(), \"days\") < 0 and prop(\"Status\") != \"Done\", \"Overdue\", dateBetween(prop(\"Due Date\"), now(), \"days\") == 0 and prop(\"Status\") != \"Done\", \"Due today\", \"On track\")"
  },
